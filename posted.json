  "recent_hooks": [
    "\ud83d\udcc9 \u0639\u0648\u0627\u0626\u062f \u0633\u0646\u062f\u0627\u062a \u0627\u0644\u062e\u0632\u0627\u0646\u0629 \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a\u0629 \u0628\u062a\u0646\u0632\u0644.. \u0627\u0644\u0633\u0648\u0642 \u0645\u0633\u062a\u0646\u064a \u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u062a\u0636\u062e\u0645 (CPI)",
    "\ud83d\udcc8 \u0631\u063a\u0645 \u062a\u062d\u0630\u064a\u0631 IMF \u0645\u0646 \u0639\u0648\u0627\u0626\u062f \u0627\u0644\u0633\u0646\u062f\u0627\u062a \u0627\u0644\u0639\u0627\u0644\u064a\u0629 \u0648\u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0644\u0646\u0641\u0637.. \u0627\u0644\u0645\u0633\u062a\u062b\u0645\u0631\u064a\u0646 \u0644\u0633\u0647 \u0628\u064a\u062a\u062d\u0645\u0644\u0648\u0627 \u0645\u062e\u0627\u0637\u0631 \u0642\u0648\u064a\u0629",
    "\u26a0\ufe0f \u0625\u064a\u0631\u0627\u0646 \u0628\u062a\u062d\u0630\u0631 \u0623\u0645\u0631\u064a\u0643\u0627: \u0645\u0645\u0643\u0646 \u062a\u0636\u0631\u0628\u0648\u0646\u0627 \u062a\u0627\u0646\u064a \u0642\u0628\u0644 \u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a \u0646\u0635 \u0627\u0644\u0645\u062f\u0629 \u0641\u064a 3 \u0646\u0648\u0641\u0645\u0628\u0631",
    "\ud83d\udcc8 10 \u0623\u0633\u0647\u0645 \u0628\u0633 \u0634\u0627\u0644\u062a 70% \u0645\u0646 \u0645\u0643\u0627\u0633\u0628 \u0627\u0644\u0640 S&P 500 \u0645\u0646 \u0645\u0627\u0631\u0633 \u0627\u0644\u0644\u064a \u0641\u0627\u062a",
    "\ud83d\udcc8 \u0627\u0644\u0633\u0648\u0642: \u0627\u0644\u0628\u064a\u062a\u0643\u0648\u064a\u0646 \u062b\u0627\u0628\u062a \u0641\u0648\u0642 83,000 \u062f\u0648\u0644\u0627\u0631 \u0642\u0628\u0644 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0636\u062e\u0645 \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a\u0629",
    "\ud83d\udee2\ufe0f \u062a\u0631\u0627\u0645\u0628 \u0642\u0627\u0644 \u0625\u0646 \u0625\u062f\u0627\u0631\u062a\u0647 \u0628\u062a\u0641\u0643\u0631 \u062a\u062e\u0641\u0641 \u0627\u0644\u0639\u0642\u0648\u0628\u0627\u062a \u0639\u0644\u0649 \u0623\u0633\u0637\u0648\u0644 \u0627\u0644\u0638\u0644 \u0627\u0644\u0644\u064a \u0628\u0646\u0642\u0644 \u0646\u0641\u0637 \u0631\u0648\u0633\u064a\u0627 \u0648\u0625\u064a\u0631\u0627\u0646 \u0648\u0641\u0646\u0632\u0648\u064a\u0644\u0627 (3 \u062f\u0648\u0644) \u0639\u0644\u0634\u0627\u0646 \u062a\u062e\u0641\u0636 \u062a\u0643\u0627\u0644\u064a\u0641 \u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0642\u064a\u0627\u0633\u064a\u0629",
    "\ud83d\udee2\ufe0f \u0628\u0639\u062f \u0645\u0627 \u062e\u0627\u0645 \u063a\u0631\u0628 \u062a\u0643\u0633\u0627\u0633 \u062a\u062c\u0627\u0648\u0632 96 \u062f\u0648\u0644\u0627\u0631 \u0644\u0644\u0628\u0631\u0645\u064a\u0644.. Nasdaq 100 \u062e\u0633\u0631 1.6% \u0641\u064a \u064a\u0648\u0645 \u0648\u0627\u062d\u062f",
    "\ud83d\udcc9 \u0646\u064a\u0643\u0627\u064a \u0627\u0644\u064a\u0627\u0628\u0627\u0646 \u0628\u064a\u062e\u0633\u0631 3.5% \u0628\u0639\u062f \u0645\u0627 \u0627\u0644\u0641\u064a\u062f\u0631\u0627\u0644\u064a \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a \u0642\u0631\u0631 \u064a\u0631\u0641\u0639 \u0627\u0644\u0641\u0627\u064a\u062f\u0629",
    "\ud83d\udcc9 \u0623\u0633\u0647\u0645 SK Hynix \u0628\u062a\u0646\u0632\u0644 10% \u0641\u064a \u064a\u0648\u0645 \u0648\u0627\u062d\u062f \u0628\u0633\u0628\u0628 \u0645\u062e\u0627\u0648\u0641 \u0631\u0641\u0639 \u0627\u0644\u0641\u0627\u064a\u062f\u0629",
    "\ud83e\udd47 \u0627\u0644\u062f\u0647\u0628 \u0628\u064a\u0642\u0639.. \u0627\u0644\u0623\u0648\u0646\u0635\u0629 \u0642\u0631\u0628\u062a \u0645\u0646 4,100 \u062f\u0648\u0644\u0627\u0631 \u0628\u0639\u062f \u0645\u0627 \u062a\u0636\u062e\u0645 \u0623\u0645\u0631\u064a\u0643\u0627 \u0648\u0635\u0644 3.7%",
    "\ud83d\udcc9 \"\u0627\u0644\u0633\u064a\u0648\u0644\u0629 \u0628\u062a\u062e\u0631\u062c \u0645\u0646 \u0627\u0644\u0643\u0628\u0627\u0631.. \u0648\u0628\u062a\u062f\u062e\u0644 \u0639\u0645\u0644\u0627\u062a \u062a\u0627\u0646\u064a\u0629!\"",
    "\ud83c\uddea\ud83c\uddfa \u0628\u0639\u062f \u062a\u0635\u0631\u064a\u062d \u0643\u0627\u0632\u0627\u0643\u0633 \u0645\u0646 \u0627\u0644\u0628\u0646\u0643 \u0627\u0644\u0645\u0631\u0643\u0632\u064a \u0627\u0644\u0623\u0648\u0631\u0648\u0628\u064a: \"\u0642\u0648\u0649 \u0627\u0644\u062a\u0636\u062e\u0645 \u0623\u0642\u0648\u0649 \u0641\u064a \u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644 \u0627\u0644\u0642\u0631\u064a\u0628\"",
    "\ud83d\udcc9 \u0628\u0648\u0631\u0635\u0629 \u0643\u0648\u0631\u064a\u0627 \u0627\u0644\u062c\u0646\u0648\u0628\u064a\u0629 (KOSPI) \u0648\u0642\u0641\u062a \u0627\u0644\u062a\u062f\u0627\u0648\u0644 \u0628\u0639\u062f \u0645\u0627 \u0646\u0632\u0644\u062a 8%",
    "\ud83d\udcc9 \u0627\u0644\u0640 S&P 500 \u062e\u0633\u0631 800 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631 \u0641\u064a \u0623\u0633\u0648\u0623 \u064a\u0648\u0645 \u0645\u0646 \u064a\u0648\u0644\u064a\u0648 2023 \u0628\u0633\u0628\u0628 \u0627\u0644\u062a\u0636\u062e\u0645 \u0627\u0644\u0644\u064a \u0628\u0642\u0649 \u0636\u0639\u0641 \u0645\u0633\u062a\u0647\u062f\u0641 \u0627\u0644\u0641\u064a\u062f\u0631\u0627\u0644\u064a.",
